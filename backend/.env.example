# ReRoute backend environment template
#
# Copy this file to `backend/.env` and fill in only what you actually have.
#
#   Copy-Item "backend/.env.example" "backend/.env"
#
# ---------------------------------------------------------------------------
# WARNING: NEVER COMMIT REAL CREDENTIALS
# ---------------------------------------------------------------------------
# Every SAP value below is a placeholder. Never paste a real client id, client
# secret, HANA password, or BTP token into this file — it is committed. If you
# need a real value, put it in `backend/.env`, which is read by
# `app.config.Settings` (see `model_config = SettingsConfigDict(env_file=".env")`).
#
# IMPORTANT: as of this commit neither `backend/.gitignore` nor
# `frontend/.gitignore` ignores `.env`, so a real `.env` file is not protected
# by git. Add that ignore rule yourself before you create a `.env`, and check
# `git status` before every commit.
#
# Field names below are the authoritative `Settings` fields from
# `backend/app/config.py`. `Settings` reads env vars case-insensitively, so the
# UPPER_SNAKE names here are the same fields as the lower_snake declarations.
# Unknown variables are ignored (`extra="ignore"`), and every variable is
# optional: delete a line to fall back to the default shown in the comment.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Path to the SQLite session store. Blank or unset -> data/reroute.db relative
# to the process working directory. On a host with an ephemeral filesystem
# (Render free tier, Railway without a volume) the file is lost on every
# restart, so replayed sessions and stored events disappear. Point this at a
# mounted persistent disk path in that case.
DATABASE_PATH=data/reroute.db


# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Browser origins allowed to call the API. Complex fields are parsed as JSON,
# so this must be a JSON array of strings, without surrounding quotes.
# Blank or unset -> ["http://localhost:5173","http://127.0.0.1:5173"] (Vite dev
# only). On split hosting you MUST set this to the exact deployed frontend
# origin, because the browser sends no Origin the API would otherwise accept.
# Localhost and 127.0.0.1 are different origins to a browser; list both if you
# keep using both.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]


# ---------------------------------------------------------------------------
# Demo-mode flags (mock-first defaults)
# ---------------------------------------------------------------------------

# Use the simulated SAP HANA pathway instead of a real HANA Cloud call.
# `true` (default) -> /route and /match are computed from the bundled fixtures
# and labelled `simulated`. `false` only attempts HANA when the driver and the
# credentials below are present; a failed live call still degrades to the same
# labelled simulated result rather than erroring.
USE_MOCK_HANA=true

# Use the simulated SAP Generative AI Hub pathway instead of a live call.
# `true` (default) -> /skills/extract and /skills/work-sample are answered by the
# local fixture scorer and labelled `simulated`. `false` attempts the Hub
# orchestration endpoint; a missing or failing call falls back to the same
# labelled simulated result.
USE_MOCK_GENAI=true

# Maximum permitted absolute Ghost Twin ranking-score movement, in points,
# before a decision is reported as FLAGGED. Blank or unset -> 5. Must be an
# integer >= 0; a negative value is rejected at settings load.
GHOST_TWIN_THRESHOLD=5


# ---------------------------------------------------------------------------
# SAP Generative AI Hub (optional; every value here is a placeholder)
# ---------------------------------------------------------------------------

# Orchestration endpoint URL from the SAP trial onboarding email. Blank -> the
# live skills-extraction and work-sample branches are never usable, so
# `USE_MOCK_GENAI=true` and the simulated scorer serves every request.
GENAI_HUB_ENDPOINT=

# OAuth client id from the trial onboarding email. Blank -> see above.
GENAI_HUB_CLIENT_ID=your-sap-client-id

# OAuth client secret. Held as a pydantic SecretStr and never logged, but a
# value written here would be committed, so leave it blank in this file.
# Blank -> see GENAI_HUB_ENDPOINT.
GENAI_HUB_CLIENT_SECRET=

# Model identifier exposed by the trial deployment, exactly as the onboarding
# email and model list spell it. Blank -> see GENAI_HUB_ENDPOINT. Do not claim a
# model on stage that you did not actually see succeed here.
GENAI_HUB_MODEL=your-sap-model-name

# Per-request timeout in seconds for the Hub call before the simulated
# response is served instead. Blank or unset -> 8.0. Must be > 0.
GENAI_HUB_TIMEOUT_SECONDS=8.0


# ---------------------------------------------------------------------------
# SAP HANA Cloud connection (optional; every value here is a placeholder)
# ---------------------------------------------------------------------------
# The `your-sap-...` values below are non-blank on purpose, so a copied file
# still shows which variables exist. Replace every one of them with your own
# before setting USE_MOCK_HANA=false, otherwise the settings look "configured"
# and the app will waste a connection attempt on a hostname that cannot resolve.
# The resulting failure is still safe: it degrades to the labelled simulated
# pathway.

# Host name of the HANA Cloud instance, with no scheme and no trailing slash.
# Blank -> `hana_is_configured()` is false, the live branch stays off, and the
# graph/vector routes are served from the bundled fixtures as `simulated`.
HANA_HOST=your-sap-hana-host

# Port for the instance. Blank or unset -> 443, which is the TLS port HANA Cloud
# uses. Must be between 1 and 65535.
HANA_PORT=443

# Database user. Blank -> see HANA_HOST.
HANA_USER=your-sap-hana-user

# Database password. Held as a pydantic SecretStr and never logged, but a value
# written here would be committed, so leave it blank in this file.
# Blank -> see HANA_HOST.
HANA_PASSWORD=

# NOTE: the trial instance presents the SAP trial certificate rather than a
# public root chain, and `app/services/hana_client.py` therefore connects with
# `validateCertificate=False` over TLS. That is acceptable for a hackathon
# rehearsal instance and is not a production setting.


# ---------------------------------------------------------------------------
# HANA keep-alive and timeouts
# ---------------------------------------------------------------------------

# Seconds between keep-alive pings meant to stop a trial instance
# auto-suspending. Blank or unset -> 600.0. Must be > 0.
# Honest status: `app/services/hana_client.py` provides `keep_alive_loop` and it
# is covered by tests, but the FastAPI lifespan does not start it yet, so this
# value currently has no runtime effect.
HANA_KEEP_ALIVE_SECONDS=600.0

# Seconds allowed for a HANA connection/ping before the local computation is
# used. Blank or unset -> 8.0. Must be > 0. It is passed to the driver as
# `connectionTimeout` and also bounds the local fallback decision, so a hung
# trial instance cannot freeze a demo request.
HANA_QUERY_TIMEOUT_SECONDS=8.0


# ---------------------------------------------------------------------------
# Quick reference: field -> variable name
# ---------------------------------------------------------------------------
#
#   database_path               -> DATABASE_PATH
#   cors_origins                -> CORS_ORIGINS
#   use_mock_hana               -> USE_MOCK_HANA
#   use_mock_genai              -> USE_MOCK_GENAI
#   ghost_twin_threshold        -> GHOST_TWIN_THRESHOLD
#   genai_hub_endpoint          -> GENAI_HUB_ENDPOINT
#   genai_hub_client_id         -> GENAI_HUB_CLIENT_ID
#   genai_hub_client_secret     -> GENAI_HUB_CLIENT_SECRET
#   genai_hub_model             -> GENAI_HUB_MODEL
#   genai_hub_timeout_seconds   -> GENAI_HUB_TIMEOUT_SECONDS
#   hana_host                   -> HANA_HOST
#   hana_port                   -> HANA_PORT
#   hana_user                   -> HANA_USER
#   hana_password               -> HANA_PASSWORD
#   hana_keep_alive_seconds     -> HANA_KEEP_ALIVE_SECONDS
#   hana_query_timeout_seconds  -> HANA_QUERY_TIMEOUT_SECONDS
#
# The short version of the live/SAP story: with the shipped defaults nothing
# leaves this machine. Every SAP integration is mock-first, the real branches
# sit behind USE_MOCK_HANA / USE_MOCK_GENAI, and blank GenAI Hub or HANA
# credentials force the simulated path even when those flags are false.
